# Reown AppKit project id — create one at https://dashboard.reown.com
# Without it the wallet button still renders, but connecting will fail.
VITE_REOWN_PROJECT_ID=

# Optional: a dedicated Robinhood Chain RPC. The public endpoint is rate-limited
# and occasionally serves an expired TLS cert from one node behind its load
# balancer, so production should point at a paid provider.
VITE_RPC_URL=
